---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---
<Base title={title} description={description} type="article">
  <article class="narrow">
    <header class="page-head">
      <a class="back-link" href="/blog/" style="font-weight:600">← All posts</a>
      <h1 style="margin-top:.6em">{title}</h1>
      <p class="muted" style="font-size:.95rem">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <> · updated {formatDate(updated)}</>} · {readingTime(post.body)}
      </p>
      {tags.length > 0 && <ul class="chips">{tags.map((t) => <li><a class="chip" href={`/blog/tags/${tagSlug(t)}/`}>#{t}</a></li>)}</ul>}
    </header>
    <div class="prose"><Content /></div>
    <nav class="post-nav" aria-label="More posts">
      <div>{older && <a class="card" style="display:block" href={`/blog/${older.id}/`}><small>← Older</small>{older.data.title}</a>}</div>
      <div style="text-align:right">{newer && <a class="card" style="display:block" href={`/blog/${newer.id}/`}><small>Newer →</small>{newer.data.title}</a>}</div>
    </nav>
  </article>
</Base>
