---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, tagSlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <div class="narrow">
    <header class="page-head">
      <a class="back-link" href="/blog/" style="font-weight:600">← All posts</a>
      <h1 style="margin-top:.6em">Posts tagged “{tag}”</h1>
    </header>
    <ul class="post-list">{posts.map((post) => <PostCard post={post} />)}</ul>
  </div>
</Base>
